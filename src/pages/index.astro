---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import categoriesData from '../../data/categories.json';
import { getSiteConfig } from '../lib/site-config';

const allArticles = await getCollection('articles');
const config = getSiteConfig();
const siteName = config.name;

// Group articles by category for counts
const articlesByCategory: Record<string, number> = {};
allArticles.forEach(a => {
  articlesByCategory[a.data.category] = (articlesByCategory[a.data.category] || 0) + 1;
});

// Get latest articles (sorted by dateModified)
const latestArticles = allArticles
  .sort((a, b) => new Date(b.data.dateModified).getTime() - new Date(a.data.dateModified).getTime())
  .slice(0, 6);

// Get popular comparisons (vs type)
const comparisons = allArticles
  .filter(a => a.data.type === 'vs')
  .slice(0, 4);

// Get top picks (best-for type)
const bestPicks = allArticles
  .filter(a => a.data.type === 'best-for')
  .slice(0, 4);
---

<BaseLayout
  title={`${siteName} — Expert Smart Home Reviews & Comparisons`}
  description="Honest, hands-on reviews and comparisons of smart home devices. Find the best security cameras, smart speakers, thermostats, and more for your home."
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-50 via-white to-blue-50 border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
      <div class="max-w-3xl">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 leading-tight" set:html={config.branding.heroTitle} />
        <p class="mt-4 text-lg text-gray-600 leading-relaxed max-w-2xl">
          {config.branding.heroDescription}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          {config.heroCTAs.map(cta => (
            <a
              href={cta.href}
              class={cta.primary
                ? 'bg-brand-600 hover:bg-brand-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors text-sm'
                : 'bg-white hover:bg-gray-50 text-gray-700 font-semibold px-6 py-3 rounded-lg border border-gray-300 transition-colors text-sm'}
            >
              {cta.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-14">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Browse by Category</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {categoriesData.categories.map(cat => (
        <CategoryCard
          name={cat.name}
          slug={cat.slug}
          description={cat.description}
          articleCount={articlesByCategory[cat.slug] || 0}
        />
      ))}
    </div>
  </section>

  <!-- Best Picks -->
  {bestPicks.length > 0 && (
    <section class="bg-gray-50 border-y border-gray-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Top Picks & Recommendations</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {bestPicks.map(article => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              slug={article.data.slug}
              category={article.data.category}
              type={article.data.type}
              dateModified={article.data.dateModified}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Popular Comparisons -->
  {comparisons.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 sm:px-6 py-14">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Popular Comparisons</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {comparisons.map(article => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            slug={article.data.slug}
            category={article.data.category}
            type={article.data.type}
            dateModified={article.data.dateModified}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Latest Articles -->
  {latestArticles.length > 0 && (
    <section class="bg-gray-50 border-y border-gray-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Latest Reviews & Guides</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {latestArticles.map(article => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              slug={article.data.slug}
              category={article.data.category}
              type={article.data.type}
              dateModified={article.data.dateModified}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
