---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TableOfContents from '../components/TableOfContents.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import AuthorBox from '../components/AuthorBox.astro';
import FAQ from '../components/FAQ.astro';
import ProductCard from '../components/ProductCard.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import ArticleCard from '../components/ArticleCard.astro';
import categoriesData from '../../data/categories.json';
import { getSiteConfig } from '../lib/site-config';

const config = getSiteConfig();

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const data = article.data;

const category = categoriesData.categories.find(c => c.slug === data.category);
const categoryName = category?.name || data.category;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: categoryName, url: `/${data.category}/` },
  { name: data.title, url: `/${data.slug}/` },
];

const showAffiliateDisclosure = data.type === 'best-for' || data.type === 'vs';
const showProductCards = data.type === 'best-for' && data.products && data.products.length > 0;
const showComparisonTable = data.products && data.products.length >= 2;

// Get related articles for internal linking
const allArticles = await getCollection('articles');
const relatedArticles = allArticles
  .filter(a => a.data.slug !== data.slug)
  .filter(a => {
    // Same category first
    if (a.data.category === data.category) return true;
    // Or explicitly linked
    if (data.relatedSlugs?.includes(a.data.slug)) return true;
    return false;
  })
  .slice(0, 4);

const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title={data.title}
  description={data.description}
  slug={data.slug}
  type={data.type}
  datePublished={data.datePublished}
  dateModified={data.dateModified}
  category={data.category}
  faq={data.faq}
  products={data.products}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <div class="lg:grid lg:grid-cols-[1fr_260px] lg:gap-10 mt-6">
      <!-- Main content -->
      <div class="min-w-0">
        <header class="mb-8">
          <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 leading-tight">
            {data.title}
          </h1>
          <div class="flex items-center gap-4 mt-4 text-sm text-gray-500">
            <span>By <strong class="text-gray-700">{config.author.name}</strong></span>
            <span>&middot;</span>
            <time datetime={data.dateModified}>
              Updated {new Date(data.dateModified).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
            </time>
          </div>
        </header>

        {showAffiliateDisclosure && <AffiliateDisclosure />}

        {/* Quick comparison table near the top for best-for and vs pages */}
        {showComparisonTable && (
          <div class="mb-8">
            <h2 class="text-xl font-bold text-gray-900 mb-3">Quick Comparison</h2>
            <ComparisonTable products={data.products!} />
          </div>
        )}

        <div class="prose prose-lg max-w-none
          prose-headings:font-bold prose-headings:text-gray-900
          prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
          prose-h3:text-xl prose-h3:mt-6 prose-h3:mb-3
          prose-p:text-gray-700 prose-p:leading-relaxed
          prose-a:text-brand-600 prose-a:font-medium hover:prose-a:text-brand-800
          prose-strong:text-gray-900
          prose-li:text-gray-700
          prose-table:border-collapse prose-table:w-full
          prose-th:bg-gray-50 prose-th:p-3 prose-th:text-left prose-th:text-sm prose-th:font-semibold prose-th:text-gray-700 prose-th:border prose-th:border-gray-200
          prose-td:p-3 prose-td:border prose-td:border-gray-200 prose-td:text-sm
        ">
          <Content />
        </div>

        {/* Product recommendation cards for best-for pages */}
        {showProductCards && (
          <div class="mt-10 space-y-6">
            <h2 class="text-2xl font-bold text-gray-900">Our Top Picks</h2>
            {data.products!.map((product, i) => (
              <ProductCard
                name={product.name}
                brand={product.brand || ''}
                price={product.price || 0}
                rating={product.rating || 4.0}
                reviewCount={product.reviewCount || 0}
                pros={product.pros || []}
                cons={product.cons || []}
                specs={product.specs || {}}
                asin={product.asin || 'B000000000'}
                affiliateTag={product.affiliateTag}
                badge={product.badge || (i === 0 ? 'Our Top Pick' : undefined)}
              />
            ))}
          </div>
        )}

        {data.faq && data.faq.length > 0 && (
          <FAQ items={data.faq} />
        )}

        {/* Related Articles */}
        {relatedArticles.length > 0 && (
          <section class="mt-12 border-t border-gray-200 pt-10">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Related Articles</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {relatedArticles.map(a => (
                <ArticleCard
                  title={a.data.title}
                  description={a.data.description}
                  slug={a.data.slug}
                  category={a.data.category}
                  type={a.data.type}
                  dateModified={a.data.dateModified}
                />
              ))}
            </div>
          </section>
        )}

        <AuthorBox />
      </div>

      <!-- Sidebar (sticky TOC) -->
      {tocHeadings.length > 0 && (
        <aside class="hidden lg:block">
          <div class="sticky top-24">
            <TableOfContents headings={headings} />
          </div>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>
