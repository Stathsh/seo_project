---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteConfig } from '../lib/site-config';

const config = getSiteConfig();
---

<BaseLayout
  title="Admin Dashboard"
  description="Access the SEO content management dashboard."
>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <div class="text-center mb-10">
      <h1 class="text-3xl font-bold text-gray-900">Admin Dashboard</h1>
      <p class="mt-3 text-gray-600">
        The content management dashboard runs as a separate local service.
      </p>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-8">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Getting Started</h2>
      <ol class="space-y-4 text-gray-700">
        <li class="flex gap-3">
          <span class="flex-shrink-0 w-7 h-7 bg-brand-50 text-brand-700 rounded-full flex items-center justify-center text-sm font-bold">1</span>
          <div>
            <p class="font-medium">Set your credentials in <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm">.env</code></p>
            <pre class="mt-2 bg-gray-50 border border-gray-200 rounded-md p-3 text-sm overflow-x-auto"><code>ADMIN_USER=admin
ADMIN_PASSWORD=your-secure-password
SESSION_SECRET=any-random-string</code></pre>
          </div>
        </li>
        <li class="flex gap-3">
          <span class="flex-shrink-0 w-7 h-7 bg-brand-50 text-brand-700 rounded-full flex items-center justify-center text-sm font-bold">2</span>
          <div>
            <p class="font-medium">Start the dashboard</p>
            <pre class="mt-2 bg-gray-50 border border-gray-200 rounded-md p-3 text-sm overflow-x-auto"><code>npm run dashboard</code></pre>
          </div>
        </li>
        <li class="flex gap-3">
          <span class="flex-shrink-0 w-7 h-7 bg-brand-50 text-brand-700 rounded-full flex items-center justify-center text-sm font-bold">3</span>
          <div>
            <p class="font-medium">Open in your browser</p>
            <p class="mt-1 text-sm text-gray-500">
              Visit <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm">http://localhost:3456</code> and sign in with your credentials.
            </p>
          </div>
        </li>
      </ol>
    </div>

    <p class="mt-8 text-center text-sm text-gray-400">
      The dashboard is a local Express server and is not accessible from this website.
    </p>
  </section>
</BaseLayout>
