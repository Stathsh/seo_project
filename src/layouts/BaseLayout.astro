---
import SEO from '../components/SEO.astro';
import { getSiteConfig } from '../lib/site-config';
import { getTheme } from '../lib/theme';

interface Props {
  title: string;
  description: string;
  slug?: string;
  type?: string;
  datePublished?: string;
  dateModified?: string;
  category?: string;
  image?: string;
  faq?: Array<{ question: string; answer: string }>;
  products?: Array<any>;
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const props = Astro.props;
const config = getSiteConfig();
const theme = getTheme();
const siteName = config.name;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || config.url;
const layoutStyle = theme.layout.style;
const isTechRadar = layoutStyle === 'techradar';
const isEditorial = layoutStyle === 'editorial';
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-V3FQW0WZC9"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-V3FQW0WZC9');
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="google-adsense-account" content="ca-pub-4961013278097698">
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4961013278097698" crossorigin="anonymous"></script>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={theme.fonts.googleUrl} rel="stylesheet" />
  <SEO {...props} siteName={siteName} siteUrl={siteUrl} authorName={config.author.name} />
  {isTechRadar && (
    <style>
      h1, h2, h3, h4, h5, h6 { text-transform: uppercase; letter-spacing: 0.02em; }
    </style>
  )}
</head>
<body class={`${isTechRadar ? 'bg-gray-100' : 'bg-white'} text-gray-800 font-sans antialiased`}>

  {/* === HEADER === */}
  {isTechRadar ? (
    <header class="bg-[#0b0b1a] sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between h-14">
          <a href="/" class="flex items-center gap-2 hover:opacity-90 transition-opacity">
            <img src="/logo.png" alt={siteName} class="h-9 w-9 rounded-full" />
            <span class="text-xl font-bold text-white font-heading tracking-wide uppercase">{siteName}</span>
          </a>
          <nav class="hidden md:flex items-center gap-1">
            {config.navigation.map(item => (
              <a href={item.href} class="px-3 py-1.5 text-sm font-medium text-gray-300 hover:text-white hover:bg-white/10 rounded transition-colors">{item.label}</a>
            ))}
          </nav>
          <button id="mobile-menu-btn" class="md:hidden p-2 text-gray-300 hover:text-white" aria-label="Toggle menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
        <div id="mobile-menu" class="hidden md:hidden pb-4 border-t border-gray-700">
          <nav class="flex flex-col gap-2 pt-3 text-sm font-medium text-gray-300">
            {config.navigation.map(item => (
              <a href={item.href} class="py-2 hover:text-white">{item.label}</a>
            ))}
          </nav>
        </div>
      </div>
      <div class="h-[3px] bg-gradient-to-r from-brand-600 via-brand-600 to-transparent"></div>
    </header>
  ) : isEditorial ? (
    <header class="border-b-2 border-gray-900 bg-white sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between h-16">
          <a href="/" class="flex items-center gap-2 hover:opacity-90 transition-opacity">
            <img src="/logo.png" alt={siteName} class="h-9 w-9 rounded-full" />
            <span class="text-2xl font-black text-gray-900 tracking-tight font-heading">{siteName}</span>
          </a>
          <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-gray-600">
            {config.navigation.map(item => (
              <a href={item.href} class="hover:text-gray-900 transition-colors">{item.label}</a>
            ))}
          </nav>
          <button id="mobile-menu-btn" class="md:hidden p-2 text-gray-600 hover:text-gray-900" aria-label="Toggle menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
        <div id="mobile-menu" class="hidden md:hidden pb-4 border-t border-gray-100">
          <nav class="flex flex-col gap-2 pt-3 text-sm font-medium text-gray-600">
            {config.navigation.map(item => (
              <a href={item.href} class="py-2 hover:text-gray-900">{item.label}</a>
            ))}
          </nav>
        </div>
      </div>
    </header>
  ) : (
    <header class="border-b border-gray-200 bg-white sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between h-16">
          <a href="/" class="flex items-center gap-2 hover:opacity-90 transition-opacity">
            <img src="/logo.png" alt={siteName} class="h-9 w-9 rounded-full" />
            <span class="text-xl font-bold text-brand-700 font-heading">{siteName}</span>
          </a>
          <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-gray-600">
            {config.navigation.map(item => (
              <a href={item.href} class="hover:text-brand-600 transition-colors">{item.label}</a>
            ))}
          </nav>
          <button id="mobile-menu-btn" class="md:hidden p-2 text-gray-600 hover:text-gray-900" aria-label="Toggle menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
        <div id="mobile-menu" class="hidden md:hidden pb-4 border-t border-gray-100">
          <nav class="flex flex-col gap-2 pt-3 text-sm font-medium text-gray-600">
            {config.navigation.map(item => (
              <a href={item.href} class="py-2 hover:text-brand-600">{item.label}</a>
            ))}
          </nav>
        </div>
      </div>
    </header>
  )}

  <main>
    <slot />
  </main>

  {/* === FOOTER === */}
  {isTechRadar ? (
    <footer class="bg-[#0b0b1a] mt-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div>
            <a href="/" class="flex items-center gap-2 hover:opacity-90 transition-opacity">
              <img src="/logo.png" alt={siteName} class="h-8 w-8 rounded-full" />
              <span class="text-xl font-bold text-white font-heading uppercase tracking-wide">{siteName}</span>
            </a>
            <p class="mt-3 text-sm text-gray-400 leading-relaxed">
              {config.branding.footerDescription}
            </p>
          </div>
          <div>
            <h4 class="font-bold text-white text-xs uppercase tracking-wide mb-4">Categories</h4>
            <ul class="space-y-2 text-sm text-gray-400">
              {config.navigation.map(item => (
                <li><a href={item.href} class="hover:text-brand-500 transition-colors">{item.label}</a></li>
              ))}
            </ul>
          </div>
          <div>
            <h4 class="font-bold text-white text-xs uppercase tracking-wide mb-4">About</h4>
            <ul class="space-y-2 text-sm text-gray-400">
              <li><a href="/about/" class="hover:text-brand-500 transition-colors">About Us</a></li>
              <li><a href="/contact/" class="hover:text-brand-500 transition-colors">Contact</a></li>
              <li><a href="/privacy/" class="hover:text-brand-500 transition-colors">Privacy Policy</a></li>
              <li><a href="/terms/" class="hover:text-brand-500 transition-colors">Terms of Use</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold text-white text-xs uppercase tracking-wide mb-4">Follow Us</h4>
            <ul class="space-y-2 text-sm text-gray-400">
              <li><a href="#" class="hover:text-brand-500 transition-colors">Twitter / X</a></li>
              <li><a href="#" class="hover:text-brand-500 transition-colors">YouTube</a></li>
              <li><a href="#" class="hover:text-brand-500 transition-colors">RSS Feed</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-10 pt-6 border-t border-gray-800">
          <p class="text-xs text-gray-500">
            &copy; {new Date().getFullYear()} {siteName}. All rights reserved. As an Amazon Associate and affiliate partner, we earn from qualifying purchases. Product prices and availability are accurate as of the date/time indicated and are subject to change.
          </p>
        </div>
      </div>
    </footer>
  ) : isEditorial ? (
    <footer class="border-t-2 border-gray-900 bg-white mt-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <a href="/" class="flex items-center gap-2 hover:opacity-90 transition-opacity">
              <img src="/logo.png" alt={siteName} class="h-8 w-8 rounded-full" />
              <span class="text-xl font-black text-gray-900 font-heading">{siteName}</span>
            </a>
            <p class="mt-2 text-sm text-gray-500">
              {config.branding.footerDescription}
            </p>
          </div>
          <div>
            <h4 class="font-semibold text-gray-900 text-sm mb-3">Categories</h4>
            <ul class="space-y-2 text-sm text-gray-500">
              {config.navigation.map(item => (
                <li><a href={item.href} class="hover:text-gray-900">{item.label}</a></li>
              ))}
            </ul>
          </div>
          <div>
            <h4 class="font-semibold text-gray-900 text-sm mb-3">About</h4>
            <ul class="space-y-2 text-sm text-gray-500">
              <li><a href="/about/" class="hover:text-gray-900">About Us</a></li>
              <li><a href="/contact/" class="hover:text-gray-900">Contact</a></li>
              <li><a href="/privacy/" class="hover:text-gray-900">Privacy Policy</a></li>
              <li><a href="/terms/" class="hover:text-gray-900">Terms of Use</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-8 pt-8 border-t border-gray-300">
          <p class="text-xs text-gray-400">
            &copy; {new Date().getFullYear()} {siteName}. All rights reserved. As an Amazon Associate and affiliate partner, we earn from qualifying purchases. Product prices and availability are accurate as of the date/time indicated and are subject to change.
          </p>
        </div>
      </div>
    </footer>
  ) : (
    <footer class="bg-gray-50 border-t border-gray-200 mt-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <a href="/" class="flex items-center gap-2 hover:opacity-90 transition-opacity">
              <img src="/logo.png" alt={siteName} class="h-8 w-8 rounded-full" />
              <span class="text-lg font-bold text-brand-700">{siteName}</span>
            </a>
            <p class="mt-2 text-sm text-gray-500">
              {config.branding.footerDescription}
            </p>
          </div>
          <div>
            <h4 class="font-semibold text-gray-900 text-sm mb-3">Categories</h4>
            <ul class="space-y-2 text-sm text-gray-500">
              {config.navigation.map(item => (
                <li><a href={item.href} class="hover:text-brand-600">{item.label}</a></li>
              ))}
            </ul>
          </div>
          <div>
            <h4 class="font-semibold text-gray-900 text-sm mb-3">About</h4>
            <ul class="space-y-2 text-sm text-gray-500">
              <li><a href="/about/" class="hover:text-brand-600">About Us</a></li>
              <li><a href="/contact/" class="hover:text-brand-600">Contact</a></li>
              <li><a href="/privacy/" class="hover:text-brand-600">Privacy Policy</a></li>
              <li><a href="/terms/" class="hover:text-brand-600">Terms of Use</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-8 pt-8 border-t border-gray-200">
          <p class="text-xs text-gray-400">
            &copy; {new Date().getFullYear()} {siteName}. All rights reserved. As an Amazon Associate and affiliate partner, we earn from qualifying purchases. Product prices and availability are accurate as of the date/time indicated and are subject to change.
          </p>
        </div>
      </div>
    </footer>
  )}

  <script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
    });
  </script>
</body>
</html>
