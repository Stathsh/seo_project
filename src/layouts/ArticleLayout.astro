---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TableOfContents from '../components/TableOfContents.astro';
import AuthorBox from '../components/AuthorBox.astro';
import FAQ from '../components/FAQ.astro';
import { getTheme } from '../lib/theme';
import { getSiteConfig } from '../lib/site-config';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    slug: string;
    category: string;
    type: string;
    datePublished: string;
    dateModified: string;
    products?: Array<any>;
    faq?: Array<{ question: string; answer: string }>;
  };
  headings: Array<{ depth: number; slug: string; text: string }>;
}

const { frontmatter, headings } = Astro.props;
const theme = getTheme();
const config = getSiteConfig();
const layoutStyle = theme.layout.style;
const isTechRadar = layoutStyle === 'techradar';
const isEditorial = layoutStyle === 'editorial';

import categoriesData from '../../data/categories.json';
const category = categoriesData.categories.find(c => c.slug === frontmatter.category);
const categoryName = category?.name || frontmatter.category;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: categoryName, url: `/${frontmatter.category}/` },
  { name: frontmatter.title, url: `/${frontmatter.slug}/` },
];
---
<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  slug={frontmatter.slug}
  type={frontmatter.type}
  datePublished={frontmatter.datePublished}
  dateModified={frontmatter.dateModified}
  category={frontmatter.category}
  faq={frontmatter.faq}
  products={frontmatter.products}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-10 mt-6">
      <!-- Main content -->
      <div class="min-w-0">
        {isTechRadar ? (
          <header class="mb-8">
            <span class="text-brand-600 text-xs font-bold uppercase tracking-widest">{categoryName}</span>
            <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 leading-tight mt-2 font-heading">
              {frontmatter.title}
            </h1>
            <div class="flex items-center gap-3 mt-4 text-sm text-gray-500">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-full bg-brand-600 flex items-center justify-center flex-shrink-0">
                  <span class="text-xs font-bold text-white">{config.author.initials}</span>
                </div>
                <span class="font-semibold text-gray-800">{config.author.name}</span>
              </div>
              <span class="text-gray-300">|</span>
              <time datetime={frontmatter.dateModified}>
                Updated {new Date(frontmatter.dateModified).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
              </time>
            </div>
          </header>
        ) : isEditorial ? (
          <header class="mb-8 pb-6 border-b border-gray-200">
            <h1 class="text-4xl sm:text-5xl font-black text-gray-900 leading-tight tracking-tight font-heading">
              {frontmatter.title}
            </h1>
            <div class="flex items-center gap-4 mt-4 text-sm text-gray-500">
              <span>By <strong class="text-gray-900">{config.author.name}</strong></span>
              <span>&middot;</span>
              <time datetime={frontmatter.dateModified}>
                Updated {new Date(frontmatter.dateModified).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
              </time>
            </div>
          </header>
        ) : (
          <header class="mb-8">
            <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 leading-tight">
              {frontmatter.title}
            </h1>
            <div class="flex items-center gap-4 mt-4 text-sm text-gray-500">
              <span>By <strong class="text-gray-700">{config.author.name}</strong></span>
              <span>&middot;</span>
              <time datetime={frontmatter.dateModified}>
                Updated {new Date(frontmatter.dateModified).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
              </time>
            </div>
          </header>
        )}

        <div class:list={[
          'prose prose-lg max-w-none',
          'prose-headings:font-bold prose-headings:text-gray-900',
          'prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4',
          'prose-h3:text-xl prose-h3:mt-6 prose-h3:mb-3',
          'prose-p:text-gray-700 prose-p:leading-relaxed',
          'prose-a:text-brand-600 prose-a:font-medium hover:prose-a:text-brand-800',
          'prose-strong:text-gray-900',
          'prose-li:text-gray-700',
          'prose-table:border-collapse prose-table:w-full',
          'prose-th:bg-gray-50 prose-th:p-3 prose-th:text-left prose-th:text-sm prose-th:font-semibold prose-th:text-gray-700 prose-th:border prose-th:border-gray-200',
          'prose-td:p-3 prose-td:border prose-td:border-gray-200 prose-td:text-sm',
          isTechRadar && 'prose-headings:font-heading',
          isEditorial && 'prose-headings:font-heading',
        ]}>
          <slot />
        </div>

        {frontmatter.faq && frontmatter.faq.length > 0 && (
          <FAQ items={frontmatter.faq} />
        )}

        <AuthorBox />
      </div>

      <!-- Sidebar (sticky TOC) -->
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
