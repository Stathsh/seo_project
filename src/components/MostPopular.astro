---
import { getTheme } from '../lib/theme';

interface Props {
  articles: Array<{ title: string; slug: string }>;
}

const { articles } = Astro.props;
const theme = getTheme();
const layoutStyle = theme.layout.style;
const isTechRadar = layoutStyle === 'techradar';
const isEditorial = layoutStyle === 'editorial';
---

{articles.length > 0 && (
  isTechRadar ? (
    <div class="border border-gray-200 overflow-hidden mt-6">
      <div class="bg-brand-600 px-4 py-2.5">
        <h3 class="text-xs font-bold text-white uppercase tracking-widest font-heading">Most Popular</h3>
      </div>
      <nav class="p-4">
        <ul class="space-y-0">
          {articles.slice(0, 4).map((article, i) => (
            <li class:list={['flex items-start gap-3 py-3', i < articles.slice(0, 4).length - 1 && 'border-b border-gray-100']}>
              <span class="text-2xl font-bold text-gray-200 leading-none font-heading flex-shrink-0 w-6 text-right">{i + 1}</span>
              <a
                href={`/${article.slug}/`}
                class="text-sm font-medium text-gray-800 hover:text-brand-600 transition-colors leading-snug"
              >
                {article.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  ) : isEditorial ? (
    <div class="border-l-2 border-gray-900 pl-4 mt-6">
      <h3 class="text-xs font-bold text-gray-900 uppercase tracking-wide mb-3">Most Popular</h3>
      <ul class="space-y-0">
        {articles.slice(0, 4).map((article, i) => (
          <li class:list={['flex items-start gap-3 py-2.5', i < articles.slice(0, 4).length - 1 && 'border-b border-gray-100']}>
            <span class="text-xl font-bold text-gray-200 leading-none flex-shrink-0 w-5 text-right">{i + 1}</span>
            <a
              href={`/${article.slug}/`}
              class="text-sm text-gray-600 hover:text-gray-900 transition-colors leading-snug"
            >
              {article.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ) : (
    <div class="bg-gray-50 rounded-xl p-5 border border-gray-200 mt-6">
      <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wide mb-3">Most Popular</h3>
      <ul class="space-y-0">
        {articles.slice(0, 4).map((article, i) => (
          <li class:list={['flex items-start gap-3 py-2.5', i < articles.slice(0, 4).length - 1 && 'border-b border-gray-100']}>
            <span class="text-xl font-bold text-gray-200 leading-none flex-shrink-0 w-5 text-right">{i + 1}</span>
            <a
              href={`/${article.slug}/`}
              class="text-sm text-gray-600 hover:text-brand-600 transition-colors leading-snug"
            >
              {article.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
)}
