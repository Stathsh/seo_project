---
import { getTheme } from '../lib/theme';

interface Props {
  name: string;
  slug: string;
  description: string;
  articleCount: number;
}

const { name, slug, description, articleCount } = Astro.props;
const theme = getTheme();
const layoutStyle = theme.layout.style;
const isTechRadar = layoutStyle === 'techradar';
const isEditorial = layoutStyle === 'editorial';

const icons: Record<string, string> = {
  'security-cameras': 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z',
  'smart-thermostats': 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z',
  'smart-speakers': 'M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z',
  'smart-lighting': 'M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18',
  'smart-doorbells': 'M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0',
  'robot-vacuums': 'M9 3.75H6.912a2.25 2.25 0 00-2.15 1.588L2.35 13.177a2.25 2.25 0 00-.1.661V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 00-2.15-1.588H15M2.25 13.5h3.86a2.25 2.25 0 012.012 1.244l.256.512a2.25 2.25 0 002.013 1.244h3.218a2.25 2.25 0 002.013-1.244l.256-.512a2.25 2.25 0 012.013-1.244h3.859M12 3v8.25m0 0l-3-3m3 3l3-3',
  'smart-plugs': 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
  'smart-hubs': 'M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 011.06 0z',
};

const iconPath = icons[slug] || icons['smart-hubs'];
---

{isTechRadar ? (
  <a href={`/${slug}/`} class="group block bg-white border border-gray-200 p-6 hover:border-brand-500 hover:shadow-lg transition-all">
    <div class="flex items-start gap-4">
      <div class="w-12 h-12 bg-brand-600 flex items-center justify-center flex-shrink-0">
        <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d={iconPath} />
        </svg>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 group-hover:text-brand-600 transition-colors font-heading uppercase text-sm tracking-wide">{name}</h3>
        <p class="text-sm text-gray-500 mt-1 leading-relaxed">{description}</p>
        <p class="text-xs text-brand-600 font-bold mt-2 uppercase tracking-wider">{articleCount} articles &rarr;</p>
      </div>
    </div>
  </a>
) : isEditorial ? (
  <a href={`/${slug}/`} class="group block bg-white border border-gray-200 p-6 hover:bg-gray-50 transition-all">
    <div class="flex items-start gap-4">
      <div class="w-12 h-12 bg-gray-100 rounded flex items-center justify-center flex-shrink-0">
        <svg class="w-6 h-6 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d={iconPath} />
        </svg>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 group-hover:text-gray-600 transition-colors font-heading">{name}</h3>
        <p class="text-sm text-gray-500 mt-1 leading-relaxed">{description}</p>
        <p class="text-xs text-gray-700 font-medium mt-2">{articleCount} articles &rarr;</p>
      </div>
    </div>
  </a>
) : (
  <a href={`/${slug}/`} class="group block bg-white border border-gray-200 rounded-xl p-6 hover:border-brand-300 hover:shadow-lg transition-all">
    <div class="flex items-start gap-4">
      <div class="w-12 h-12 bg-brand-50 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-brand-100 transition-colors">
        <svg class="w-6 h-6 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d={iconPath} />
        </svg>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 group-hover:text-brand-700 transition-colors">{name}</h3>
        <p class="text-sm text-gray-500 mt-1 leading-relaxed">{description}</p>
        <p class="text-xs text-brand-600 font-medium mt-2">{articleCount} articles &rarr;</p>
      </div>
    </div>
  </a>
)}
