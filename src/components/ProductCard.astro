---
import { getTheme } from '../lib/theme';

interface Props {
  name: string;
  brand: string;
  price: number;
  rating: number;
  reviewCount: number;
  pros: string[];
  cons: string[];
  specs: Record<string, string>;
  asin: string;
  affiliateTag?: string;
  badge?: string;
  image?: string;
}

const {
  name,
  brand,
  price,
  rating,
  reviewCount,
  pros,
  cons,
  specs,
  asin,
  affiliateTag = 'YOURTAG-20',
  badge,
  image,
} = Astro.props;

const theme = getTheme();
const layoutStyle = theme.layout.style;
const isTechRadar = layoutStyle === 'techradar';
const isEditorial = layoutStyle === 'editorial';

const affiliateUrl = `https://amazon.com/dp/${asin}?tag=${affiliateTag}`;
const stars = Math.round(rating * 2) / 2;
const fullStars = Math.floor(stars);
const hasHalf = stars % 1 !== 0;
const emptyStars = 5 - fullStars - (hasHalf ? 1 : 0);
const topSpecs = Object.entries(specs).slice(0, 4);

const cardClass = isTechRadar
  ? 'border border-gray-200 p-6 bg-white hover:shadow-md transition-shadow'
  : isEditorial
    ? 'border border-gray-200 p-6 bg-white'
    : 'border border-gray-200 rounded-xl p-6 bg-white hover:shadow-md transition-shadow';

const badgeClass = isTechRadar
  ? 'inline-block bg-brand-600 text-white text-xs font-bold px-3 py-1 mb-3 uppercase tracking-widest font-heading'
  : isEditorial
    ? 'inline-block bg-gray-900 text-white text-xs font-bold px-3 py-1 mb-3 uppercase tracking-wide'
    : 'inline-block bg-brand-600 text-white text-xs font-bold px-3 py-1 rounded-full mb-3 uppercase tracking-wide';

const ctaClass = isTechRadar
  ? 'inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white font-bold px-5 py-2.5 transition-colors text-sm uppercase tracking-wide font-heading'
  : isEditorial
    ? 'inline-flex items-center gap-2 bg-gray-900 hover:bg-gray-700 text-white font-semibold px-5 py-2.5 transition-colors text-sm'
    : 'inline-flex items-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-semibold px-5 py-2.5 rounded-lg transition-colors text-sm';

const imageClass = isTechRadar
  ? 'bg-gray-100 aspect-square flex items-center justify-center'
  : isEditorial
    ? 'bg-gray-50 aspect-square flex items-center justify-center'
    : 'bg-gray-100 rounded-lg aspect-square flex items-center justify-center';
---

<div class={cardClass}>
  {badge && (
    <span class={badgeClass}>
      {badge}
    </span>
  )}

  <div class="flex flex-col sm:flex-row gap-5">
    <!-- Product image placeholder -->
    <div class="sm:w-40 flex-shrink-0">
      <div class={imageClass}>
        <svg class="w-16 h-16 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    </div>

    <div class="flex-1 min-w-0">
      <h3 class:list={['text-xl font-bold text-gray-900', isTechRadar && 'font-heading']}>{name}</h3>
      <p class="text-sm text-gray-500 mt-0.5">by {brand}</p>

      <!-- Rating -->
      <div class="flex items-center gap-2 mt-2">
        <div class="flex items-center" aria-label={`${rating} out of 5 stars`}>
          {Array.from({ length: fullStars }).map(() => (
            <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
          {hasHalf && (
            <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
              <defs><clipPath id="half"><rect x="0" y="0" width="10" height="20" /></clipPath></defs>
              <path clip-path="url(#half)" d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              <path fill="#e5e7eb" d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" clip-path="url(#halfRight)" />
            </svg>
          )}
          {Array.from({ length: emptyStars }).map(() => (
            <svg class="w-4 h-4 text-gray-300" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <span class="text-sm font-medium text-gray-700">{rating}</span>
        <span class="text-sm text-gray-400">({reviewCount.toLocaleString()} reviews)</span>
      </div>

      <!-- Key Specs -->
      <ul class="mt-3 space-y-1">
        {topSpecs.map(([key, value]) => (
          <li class="text-sm text-gray-600 flex items-start gap-1.5">
            <svg class="w-4 h-4 text-brand-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span><strong class="text-gray-700">{key}:</strong> {value}</span>
          </li>
        ))}
      </ul>

      <!-- Pros / Cons -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
        <div>
          <p class="text-xs font-bold uppercase text-green-700 mb-1.5">Pros</p>
          <ul class="space-y-1">
            {pros.slice(0, 3).map(pro => (
              <li class="text-sm text-gray-600 flex items-start gap-1.5">
                <span class="text-green-500 font-bold flex-shrink-0">+</span>
                {pro}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="text-xs font-bold uppercase text-red-700 mb-1.5">Cons</p>
          <ul class="space-y-1">
            {cons.slice(0, 3).map(con => (
              <li class="text-sm text-gray-600 flex items-start gap-1.5">
                <span class="text-red-500 font-bold flex-shrink-0">&minus;</span>
                {con}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Price + CTA -->
      <div class="flex items-center justify-between mt-5 pt-4 border-t border-gray-100">
        <p class="text-2xl font-bold text-gray-900">${price.toFixed(2)}</p>
        <a
          href={affiliateUrl}
          target="_blank"
          rel="nofollow noopener sponsored"
          class={ctaClass}
        >
          Check Price on Amazon
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>
