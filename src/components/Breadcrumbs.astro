---
interface Props {
  items: Array<{ name: string; url: string }>;
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm text-gray-500">
  <ol class="flex items-center flex-wrap gap-1">
    {items.map((item, i) => (
      <li class="flex items-center">
        {i > 0 && (
          <svg class="w-4 h-4 mx-1 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        )}
        {i === items.length - 1 ? (
          <span class="text-gray-700 font-medium truncate max-w-[200px] sm:max-w-none">{item.name}</span>
        ) : (
          <a href={item.url} class="hover:text-brand-600 transition-colors whitespace-nowrap">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
