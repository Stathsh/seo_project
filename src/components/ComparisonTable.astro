---
interface Props {
  products: Array<{
    name: string;
    brand: string;
    price: number;
    rating: number;
    specs: Record<string, string>;
    asin: string;
  }>;
  affiliateTag?: string;
}

const { products, affiliateTag = 'YOURTAG-20' } = Astro.props;

// Gather all spec keys from all products
const allSpecKeys = [...new Set(products.flatMap(p => Object.keys(p.specs)))];
---

<div class="my-8 overflow-x-auto -mx-4 sm:mx-0">
  <div class="inline-block min-w-full align-middle">
    <table class="min-w-full border-collapse border border-gray-200 rounded-lg overflow-hidden text-sm">
      <thead>
        <tr class="bg-gray-50">
          <th class="border border-gray-200 p-3 text-left font-semibold text-gray-700 min-w-[140px] sticky left-0 bg-gray-50 z-10">Feature</th>
          {products.map(product => (
            <th class="border border-gray-200 p-3 text-center font-semibold text-gray-900 min-w-[160px]">
              <div class="flex flex-col items-center gap-1">
                <span>{product.name}</span>
                <span class="text-xs font-normal text-gray-500">by {product.brand}</span>
              </div>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        <!-- Price row -->
        <tr class="bg-white">
          <td class="border border-gray-200 p-3 font-medium text-gray-700 sticky left-0 bg-white z-10">Price</td>
          {products.map(product => (
            <td class="border border-gray-200 p-3 text-center font-bold text-gray-900">
              ${product.price.toFixed(2)}
            </td>
          ))}
        </tr>
        <!-- Rating row -->
        <tr class="bg-gray-50/50">
          <td class="border border-gray-200 p-3 font-medium text-gray-700 sticky left-0 bg-gray-50/50 z-10">Rating</td>
          {products.map(product => (
            <td class="border border-gray-200 p-3 text-center">
              <span class="font-bold text-gray-900">{product.rating}</span>
              <span class="text-gray-400">/5</span>
            </td>
          ))}
        </tr>
        <!-- Spec rows -->
        {allSpecKeys.map((key, i) => (
          <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50/50'}>
            <td class={`border border-gray-200 p-3 font-medium text-gray-700 capitalize sticky left-0 z-10 ${i % 2 === 0 ? 'bg-white' : 'bg-gray-50/50'}`}>
              {key.replace(/([A-Z])/g, ' $1').trim()}
            </td>
            {products.map(product => (
              <td class="border border-gray-200 p-3 text-center text-gray-600">
                {product.specs[key] || '—'}
              </td>
            ))}
          </tr>
        ))}
        <!-- CTA row -->
        <tr class="bg-white">
          <td class="border border-gray-200 p-3 sticky left-0 bg-white z-10"></td>
          {products.map(product => (
            <td class="border border-gray-200 p-3 text-center">
              <a
                href={`https://amazon.com/dp/${product.asin}?tag=${affiliateTag}`}
                target="_blank"
                rel="nofollow noopener sponsored"
                class="inline-block bg-accent-500 hover:bg-accent-600 text-white font-semibold px-4 py-2 rounded-lg transition-colors text-xs"
              >
                Check Price
              </a>
            </td>
          ))}
        </tr>
      </tbody>
    </table>
  </div>
</div>
