# Required: Anthropic API key for content generation
ANTHROPIC_API_KEY=your-key-here

# Required: Your site's production URL (used for sitemap, canonical URLs, OG tags)
SITE_URL=https://smarthomeranked.com

# Required: Amazon Associates affiliate tag
AMAZON_AFFILIATE_TAG=yourtag-20

# Optional: Site display name (defaults to site.json value)
SITE_NAME=SmartHomeRanked

# Optional: Dashboard port (default 3456)
DASHBOARD_PORT=3456

# Optional: Dashboard admin credentials (login is required when set)
ADMIN_USER=admin
ADMIN_PASSWORD=your-secure-password
SESSION_SECRET=any-random-string

# Optional: Active site for multi-site builds (default: _default)
# ACTIVE_SITE=_default

# Optional: Netlify build hook URL for triggering deploys from GitHub Actions
# Get this from Netlify > Site > Build & deploy > Build hooks
# NETLIFY_BUILD_HOOK=https://api.netlify.com/build_hooks/your-hook-id
